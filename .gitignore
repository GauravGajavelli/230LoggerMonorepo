# ── Build output ──────────────────────────────────────────────────────────────
target/
bin/
*.class
Frontend/dist/

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ── Environment & secrets ──────────────────────────────────────────────────────
# Never commit — contains API keys, SECRET_KEY, RELAY_SECRET, etc.
.env
**/.env

# ── Student data ───────────────────────────────────────────────────────────────
# Rosters (student IDs + email addresses)
Frontend/data/roster.csv
Frontend/data/roster.dev.csv
#
# Student submission tars
Frontend/data/*/tars/
#
# Pipeline output per student (feedback JSON, diffs, code snapshots)
Frontend/data/*/output/
#
Frontend/data/

# Database (tokens, events, email queue)
Frontend/db/

# ── Runtime / generated ────────────────────────────────────────────────────────
Frontend/tmp/
Pipeline/cache/

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
/Frontend/data-server-pdfs
