# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=REPLACE_WITH_RANDOM_64_CHAR_HEX
RELAY_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_64_CHAR_HEX

PORT=3000
DATA_DIR=./data
DB_PATH=./db/feedback.db
BASE_URL=http://localhost:3000

# Pipeline (paths relative to Frontend/)
PIPELINE_JAR=../Pipeline/target/csse230-feedback.jar
LLM_CACHE_DIR=../Pipeline/cache/llm

# Current assignment (updated each cycle)
ASSIGNMENT_DISPLAY_NAME=Binary Search Tree
ASSIGNMENT_SLUG=bst

# RoseFire authentication
# 1. Go to https://rosefire.csse.rose-hulman.edu
# 2. Log in with your Rose-Hulman credentials
# 3. Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 4. Paste that secret as secretOrPrivateKey during registration — algorithm: "HMAC using SHA-256" (HS256)
# 5. Copy the returned registryToken UUID here
# ROSEFIRE_SECRET stays server-side (never expose it); ROSEFIRE_REGISTRY_TOKEN is safe to embed
ROSEFIRE_SECRET=REPLACE_WITH_YOUR_ROSEFIRE_SECRET
ROSEFIRE_REGISTRY_TOKEN=REPLACE_WITH_YOUR_REGISTRY_TOKEN_UUID

# Local testing — visit /feedback?token=demo to see the demo frontend.json
# Leave unset or remove in production
DEMO_TOKEN=demo

# Dev only — set to true to bypass RoseFire auth and serve student JSON directly from
# disk in the Vite dev server. Lets you browse /feedback?token=<any-real-token> without
# Express running. NEVER set this in production.
# DEV_BYPASS_AUTH=true

# Dev only — when set, ALL outgoing emails are redirected to this address instead of
# the real student recipient. The DB still records the real recipient; only the push to
# the relay is redirected. Subject is prefixed "[DEV → real@addr]" so you can tell
# which student's email you're looking at. NEVER set this in production.
# EMAIL_DEV_REDIRECT=gajavegs@rose-hulman.edu
