	public boolean isEmpty() {
		// TODO Auto-generated method stub
		return this.size() == 0;
	}

	public boolean containsNonBST(T i) {
		// TODO Auto-generated method stub
		return containsNonBSTHelper(i, root);
	}
	private boolean containsNonBSTHelper(T i, Node cur) {
		if (cur == NULL_NODE) {
			return false;
		}
		if (cur.data.equals(i)) {
			return true;
		}
		return containsNonBSTHelper(i, cur.left) || containsNonBSTHelper(i, cur.right);
	}
