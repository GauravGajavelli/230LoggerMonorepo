	public String toString() {
		StringBuilder sb = new StringBuilder();
		sb.append("[");
		this.toStringHelper(root, sb);
		sb.append("]");
		return sb.toString();
	}
	
	private void toStringHelper(Node cur, StringBuilder sb) {
		this.toStringHelper(root.left, sb);
		if (sb.length() == 1) {
			sb.append(",");
		}
		sb.append(root.data.toString());
		this.toStringHelper(root.right, sb);
	}
