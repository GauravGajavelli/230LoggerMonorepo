	public ArrayList<T> toArrayList() {
		ArrayList<T> list = new ArrayList<>();
		this.toArrayListHelper(root, list);
		return list;
	}
	
	private void toArrayListHelper(Node cur, ArrayList list) {
		if (cur == NULL_NODE) {
			return;
		}
		this.toArrayListHelper(cur.left, list);
		list.add(cur.data);
		this.toArrayListHelper(cur.right, list);
	}
