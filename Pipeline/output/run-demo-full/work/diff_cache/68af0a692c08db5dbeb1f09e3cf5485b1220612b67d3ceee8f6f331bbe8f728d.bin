	public Iterator<T> iterator() {
		return new inOrderIter(this);
	}
	
	private class inOrderIter implements Iterator<T> {
		private Stack<Node> stack;
		private Stack<Integer> flags;
		private int version;
		private BinarySearchTree<T> binarySearchTree;
		
		public inOrderIter(BinarySearchTree<T> binarySearchTree) {
			stack = new Stack<Node>();
			flags = new Stack<Integer>();
			if (binarySearchTree.root != NULL_NODE) {
				stack.push(binarySearchTree.root);
				flags.push(1);
			}
			version = binarySearchTree.version;
			this.binarySearchTree = binarySearchTree;
			
		}

		@Override
		public boolean hasNext() {
			if (binarySearchTree.version != this.version) {
				return false;
			}
			return !stack.isEmpty();
		}
		
		/*
		 inOrderRec(Node cur) {
		 	if (cur == NULL_NODE) {
		 		return;
		 	}
		 	Node left = cur.left;   // 1 means we've to do this part
		 	if (left != NULL_NODE) {
		 		inOrderRec(left);
		 	}
		 	l.add(cur);
		 	Node right = cur.right; // 2 means this part
		 	if (right != NULL_NODE) {
		 		inOrderRec(right);
	 		}
		 }
		 * */

		@Override
		public T next() {
			if (binarySearchTree.version != this.version) {
				return null;
			}
			
			if (!hasNext()) {
				throw new NoSuchElementException();
			}

			Node cur = stack.pop();
			int flag = flags.pop();
			
			if (flag == 1) {
				stack.push(cur);
				flags.push(2); // when we see it again we'll know to remove for good
				
				Node left = cur.left;   // 1 means we've to do this part
				Node prev = cur;
			 	while (left != NULL_NODE) {
			 		stack.push(left);
			 		flags.push(1);
			 		prev = left;
			 		left = left.left;
			 	}
				return prev.data;
			}
		 	Node right = cur.right; // 2 means this part
		 	if (right != NULL_NODE) {
		 		stack.push(right);
		 		flags.push(1);
		 		return cur.data;
	 		}
		 	return null;
		}
		
	}
