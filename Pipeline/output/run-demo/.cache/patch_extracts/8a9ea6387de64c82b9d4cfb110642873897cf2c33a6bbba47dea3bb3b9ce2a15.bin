	// Ez, just do a comparison; if equal, return false
	// If we find its spot
	public boolean insert(T i) {
		if (this.root == NULL_NODE) {
			root = new Node(i);
			return true;
		}
		boolean[] b = new boolean[1];
		b[0] = false;
		insertHelper(root, i, b);
		return b[0];
	}

	private Node insertHelper(Node cur, T i, boolean[] b) {
		if (cur == NULL_NODE) {
			b[0] = true;
			return new Node(i);
		}
		int comparison = i.compareTo(cur.data);
		if (comparison == 0) {
			return cur;
		} else if (comparison < 0) { // i < cur.data
			// it belongs left
			Node newLeft = insertHelper(cur.left, i, b);
			cur.left = newLeft;
		} else { // i > cur.data
			Node newRight = insertHelper(cur.right, i, b);
			cur.right = newRight;
		}
		return cur;
	}
